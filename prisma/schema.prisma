generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries (Prisma Client). Supabase transaction pooler, port 6543, with ?pgbouncer=true.
  url       = env("DATABASE_URL")
  // Migrations and `prisma db push`. Supabase session pooler, port 5432.
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  supabaseId        String?   @unique
  telegramId        String?   @unique
  telegramUsername  String?
  invitedBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  profile           Profile?
  apiKeys           ApiKey[]
  matches           JobMatch[]
  applications      Application[]
  aiUsage           AiUsage[]
  searchRuns        SearchRun[]
  
  @@index([email])
  @@index([telegramId])
}

model Profile {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cvText            String?   @db.Text
  cvFileName        String?
  skills            String[]
  
  // Job filters
  location          String?
  remoteOnly        Boolean   @default(false)
  countryEligible   String?
  languages         String[]
  salaryMin         Int?
  salaryMax         Int?
  stackKeywords     String[]
  skillGaps         String[]
  
  // Writing rules for cover letters
  writingRules      String?   @db.Text
  
  // Company watchlist
  watchedCompanies  String[]

  // CV-first onboarding (extracted by AI, edited by the user)
  fullName          String?
  targetRoles       String[]
  seniority         String?
  yearsExperience   Int?
  searchKeywords    String[]
  sourceIds         String[]
  onboardedAt       DateTime?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ApiKey {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  provider          String    // "openai", "anthropic", "gemini", "xai"
  encryptedKey      String    @db.Text
  iv                String
  authTag           String
  
  isActive          Boolean   @default(true)
  expiresAt         DateTime?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([userId])
}

model JobSource {
  id                String    @id @default(uuid())
  company           String
  sector            String?
  sourceType        String    // "greenhouse", "lever", "ashby", "workable", etc.
  sourceUrl         String
  careersUrl        String?
  isActive          Boolean   @default(true)
  
  lastFetchedAt     DateTime?
  lastSuccessAt     DateTime?
  lastError         String?
  
  jobs              Job[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@unique([company, sourceUrl])
  @@index([isActive])
}

model Job {
  id                String    @id @default(uuid())
  sourceId          String
  source            JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  
  externalId        String    // ID from the job board
  // Hiring company when the source is an aggregator (Remotive, Arbeitnow…); null = source.company
  company           String?
  title             String
  location          String?
  remote            Boolean   @default(false)
  description       String    @db.Text
  requirements      String?   @db.Text
  salaryMin         Int?
  salaryMax         Int?
  currency          String?
  postedAt          DateTime?
  url               String
  dedupeKey         String?

  isActive          Boolean   @default(true)
  
  matches           JobMatch[]
  applications      Application[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@unique([sourceId, externalId])
  @@index([isActive])
  @@index([postedAt])
  @@index([dedupeKey])
}

model JobMatch {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId             String
  job               Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  score             Int       // 0-100
  reasons           String[]
  redFlags          String[]
  priority          String    // "high", "medium", "low"
  
  coverLetter       String?   @db.Text
  cvAdvice          Json?
  tailoredCv        String?   @db.Text
  // true = rejected by the rule pre-filter, never sent to the model, hidden in the UI
  filtered          Boolean   @default(false)
  
  notifiedAt        DateTime?
  viewedAt          DateTime?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@unique([userId, jobId])
  @@index([userId, score])
  @@index([userId, filtered])
}

model Application {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId             String?
  job               Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  
  company           String
  role              String
  url               String?
  
  status            String    @default("to_apply") // "to_apply", "applied", "on_hold", "rejected", "interview", "offer", "skip"
  
  appliedAt         DateTime?
  followUpAt        DateTime?
  followUpSent      Boolean   @default(false)
  
  contact           String?
  salaryExpectation String?
  notes             String?   @db.Text
  
  coverLetter       String?   @db.Text
  cvVersion         String?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([userId, status])
  @@index([followUpAt])
}

model InviteCode {
  id                String    @id @default(uuid())
  code              String    @unique
  createdBy         String    // admin user ID
  usedBy            String?
  usedAt            DateTime?
  expiresAt         DateTime?
  
  createdAt         DateTime  @default(now())
  
  @@index([code])
}

model CronJob {
  id                String    @id @default(uuid())
  name              String    @unique
  lastRunAt         DateTime?
  lastStatus        String?   // "success", "error"
  lastError         String?   @db.Text
  currentBatch      Int       @default(0)
  totalBatches      Int       @default(0)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// Per-user daily AI usage counters (shared Gemini key quotas).
model AiUsage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String   // YYYY-MM-DD (UTC)
  kind      String   // "score" | "write" | "parse"
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, day, kind])
}

/// One onboarding / manual search run, advanced in small serverless-safe steps.
model SearchRun {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String    @default("fetching") // fetching | scoring | done | error
  sourceIds    String[]
  sourcesDone  Int       @default(0)
  jobsFound    Int       @default(0)
  filtered     Int       @default(0)
  scored       Int       @default(0)
  queued       Int       @default(0)
  note         String?
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, createdAt])
}
