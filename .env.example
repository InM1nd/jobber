# Database
DATABASE_URL="postgresql://user:password@localhost:5432/jobber"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Encryption for API keys (generate with: openssl rand -hex 32)
ENCRYPTION_KEY="your-64-character-hex-string"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Vercel Cron Secret (generate random string)
CRON_SECRET="your-cron-secret"

# App URL. Use the port you run locally (dev script uses 43123).
NEXT_PUBLIC_APP_URL="http://127.0.0.1:43123"

# Set to false once Supabase URL is filled in. If unset and Supabase URL is
# empty, the app opens in demo mode with sample matches.
DEMO_MODE="false"

# Email that may create invite codes, and the account the seed script creates.
OWNER_EMAIL="you@example.com"

# Optional. Printed by the seed script when omitted.
SEED_INVITE_CODE=""
