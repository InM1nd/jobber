# Supabase transaction pooler (port 6543). Prisma Client uses this at runtime.
# pgbouncer=true tells Prisma not to use prepared statements on the transaction pooler.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase session pooler (port 5432). Prisma uses this for db push and migrations only.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Encryption for API keys (generate with: openssl rand -hex 32)
ENCRYPTION_KEY="your-64-character-hex-string"

# Telegram bot token. Also the HMAC key for Mini App initData.
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Public bot username without @, and the short name from BotFather /newapp.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="your_bot"
TELEGRAM_MINI_APP_SHORT_NAME="jobber"

# Vercel Cron Secret (generate random string)
CRON_SECRET="your-cron-secret"

# App URL. Use the port you run locally (dev script uses 43123).
NEXT_PUBLIC_APP_URL="http://127.0.0.1:43123"

# Set to false once Supabase URL is filled in. If unset and Supabase URL is
# empty, the app opens in demo mode with sample matches.
DEMO_MODE="false"

# Numeric Telegram user id of the owner. That account can open the Mini App
# without an invite and is the only one who can mint invites.
# Leave empty to treat the first person who opens the app with SEED_INVITE_CODE as the owner.
OWNER_TELEGRAM_ID=""

# Invite printed by the seed script. The first Telegram user who opens the app
# with this code becomes the owner when OWNER_TELEGRAM_ID is empty.
SEED_INVITE_CODE=""

# Shared AI (server-side only). Everyone uses this key with daily quotas.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.5-flash"
# GEMINI_MODEL_LITE="gemini-3.5-flash-lite"
# GEMINI_FLASH_FALLBACK=false   # allow Flash (20 RPD) as fallback for CV/plan/letters
# GEMINI_RPM_LITE=15
# GEMINI_RPD_LITE=500
# GEMINI_RPD_FLASH=20
# GEMINI_RPD_MARGIN=20
# GEMINI_ONBOARDING_RESERVE=80
# AI_DAILY_SCORE_CALLS=6        # requests; each scores up to 5 jobs
# AI_DAILY_WRITES=4
# AI_DAILY_CV_PARSES=5
# AI_BYO_DAILY_SCORE_CALLS=80   # users with their own Gemini key
# AI_BYO_DAILY_WRITES=60
# AI_BYO_DAILY_CV_PARSES=20
# Optional free job APIs
# ADZUNA_APP_ID=""
# ADZUNA_APP_KEY=""
# JOOBLE_API_KEY=""

# Owner-only Austrian scrapers (karriere.at, StepStone.at, derStandard). Only for OWNER_TELEGRAM_ID.
OWNER_SCRAPERS=false
# SCRAPER_MAX_PAGES_PER_DAY=12
# SCRAPER_DELAY_MS=2500
# SCRAPER_DETAILS_PER_RUN=6
# Extra Telegram ids allowed to use the scrapers (comma-separated), besides OWNER_TELEGRAM_ID.
# SCRAPER_TELEGRAM_IDS=
# Shared scraper sources are refetched at most every N hours (one fetch serves all users).
# SCRAPER_FRESH_HOURS=12
# Temporary: scrapers for ALL users (shared caps/cache kept). To go back to the allowlist:
# SCRAPER_ALLOW_ALL=false and SCRAPER_TELEGRAM_IDS=<id1>,<id2> (plus OWNER_TELEGRAM_ID).
# SCRAPER_ALLOW_ALL=false
