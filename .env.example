# Supabase transaction pooler (port 6543). Prisma Client uses this at runtime.
# pgbouncer=true tells Prisma not to use prepared statements on the transaction pooler.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase session pooler (port 5432). Prisma uses this for db push and migrations only.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Encryption for API keys (generate with: openssl rand -hex 32)
ENCRYPTION_KEY="your-64-character-hex-string"

# Telegram bot token. Also the HMAC key for Mini App initData.
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Public bot username without @, and the short name from BotFather /newapp.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="your_bot"
TELEGRAM_MINI_APP_SHORT_NAME="jobber"

# Vercel Cron Secret (generate random string)
CRON_SECRET="your-cron-secret"

# App URL. Use the port you run locally (dev script uses 43123).
NEXT_PUBLIC_APP_URL="http://127.0.0.1:43123"

# Set to false once Supabase URL is filled in. If unset and Supabase URL is
# empty, the app opens in demo mode with sample matches.
DEMO_MODE="false"

# Numeric Telegram user id of the owner. That account can open the Mini App
# without an invite and is the only one who can mint invites.
# Leave empty to treat the first person who opens the app with SEED_INVITE_CODE as the owner.
OWNER_TELEGRAM_ID=""

# Invite printed by the seed script. The first Telegram user who opens the app
# with this code becomes the owner when OWNER_TELEGRAM_ID is empty.
SEED_INVITE_CODE=""
